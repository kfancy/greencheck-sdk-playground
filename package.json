{
  "name": "greencheck-client-playground",
  "version": "0.0.1",
  "description": "playground for working with greencheck client SDK",
  "license": "ISC",
  "author": "kfancy",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build && tsup",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsup --watch",
    "dev:client": "vite",
    "start": "node dist/server/index.js",
    "_dev": "ts-node --esm src/index.ts",
    "_build": "vite build",
    "_start": "NODE_ENV=production node index.js",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx}' 'frontend/**/*.{ts,tsx,js,jsx,css,html}'",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'frontend/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx}' 'frontend/**/*.{ts,tsx}'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@greencheck/sdk-client": "^0.0.1",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.0",
    "tsup": "^8.0.1",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "vite": "^8.0.7"
  }
}
